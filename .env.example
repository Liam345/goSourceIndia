# Copy to .env.local and fill in.
#
# Without RESEND_API_KEY the RFQ form still accepts submissions, but enquiries
# are only written to the server console — they will NOT reach your inbox.
# Set this before you send your first cold email.

# https://resend.com — verify your sending domain first
RESEND_API_KEY=

# Where enquiries are delivered
RFQ_TO_EMAIL=rfq@gosourceindia.com

# Must be an address on a domain verified in Resend
RFQ_FROM_EMAIL=enquiries@gosourceindia.com
